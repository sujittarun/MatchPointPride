{
  "name": "matchpoint-pride",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Match Point Pride \u2014 academy operations console",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild scripts/test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/mpp-test.cjs --log-level=error && node node_modules/.cache/mpp-test.cjs",
    "simulate": "esbuild scripts/simulate.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/mpp-sim.cjs --log-level=error && node node_modules/.cache/mpp-sim.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "esbuild": "^0.24.0"
  }
}
