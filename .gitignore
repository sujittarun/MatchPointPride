dist
# The Android web bundle. `android/` itself is committed — it holds the
# icon, the manifest and the theme — but its copy of the built assets
# under app/src/main/assets/public is not (see android/.gitignore).
dist-android
dist-ssr
*.local
.DS_Store
.vite
*.tsbuildinfo

# Credentials must never reach a public repo. .mcp.json can hold an
# access token if an MCP server is added with --scope project.
.mcp.json
.env
.env.*
!.env.example
