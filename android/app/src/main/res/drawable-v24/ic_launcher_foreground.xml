<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's foreground layer: the shuttlecock, in ink.

     Path data matches src/components/BrandMark.tsx exactly — the same
     feather skirt and the same cork, in the same 24-unit box — so the
     icon on the home screen and the mark in the app's top bar are one
     drawing. The circle is written as two arcs because a vector
     drawable has paths and nothing else.

     The group scales 24 units to 62.64 (0.58 of 108, the same 0.58
     BrandMark uses to size the glyph inside its tile) and centres it:
     (108 - 62.64) / 2 = 22.68. The result is about 47dp tall inside the
     72dp safe zone, so no launcher mask clips it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.61"
        android:scaleY="2.61"
        android:translateX="22.68"
        android:translateY="22.68">
        <path
            android:fillColor="#0B1004"
            android:pathData="M9.5,12.9 L6.9,4.9 A1.1,1.1 0 0 1 7.95,3.4 H16.05 A1.1,1.1 0 0 1 17.1,4.9 L14.5,12.9 Z" />
        <path
            android:fillColor="#0B1004"
            android:pathData="M8.5,17.6 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
    </group>
</vector>
