<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's foreground layer: the shuttlecock, in ink.

     Path data matches src/components/BrandMark.tsx exactly — the same
     bound band, the same five feathers, the same domed cork, in the
     same 24-unit box — so the icon on the home screen and the mark in
     the app's top bar are one drawing.

     The group scales 24 units to 62.64 (0.58 of 108, the same 0.58
     BrandMark uses to size the glyph inside its tile) and centres it:
     (108 - 62.64) / 2 = 22.68. The result is about 47dp tall inside the
     72dp safe zone, so no launcher mask clips it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.61"
        android:scaleY="2.61"
        android:translateX="22.68"
        android:translateY="22.68">
        <path
            android:fillColor="#0B1004"
            android:pathData="M8.05,4.3 H15.95 A1.05,1.05 0 0 1 17,5.35 V6.4 H7 V5.35 A1.05,1.05 0 0 1 8.05,4.3 Z M7,6 H8.7 L10.44,15.2 H9.9 Z M9.3,6 H10.7 L11.28,15.2 H11.04 Z M11.3,6 H12.7 L12.12,15.2 H11.88 Z M13.3,6 H14.7 L12.96,15.2 H12.72 Z M15.3,6 H17 L14.1,15.2 H13.56 Z" />
        <path
            android:fillColor="#0B1004"
            android:pathData="M10.1,14.9 H13.9 V17.8 A1.9,1.9 0 0 1 12,19.7 A1.9,1.9 0 0 1 10.1,17.8 Z" />
    </group>
</vector>
