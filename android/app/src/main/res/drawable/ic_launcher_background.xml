<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's background layer: the brand tile, full bleed.

     108dp is the adaptive-icon canvas. The launcher masks it to
     whatever shape the device uses — circle, squircle, rounded square —
     so this layer has to fill all of it and keep nothing that matters
     near the edges. The shuttlecock lives in the foreground layer,
     inside the 72dp safe zone.

     The gradient is the one BrandMark already draws in CSS:
     linear-gradient(150deg, #C8FF4D, #A3D62F). 150deg in CSS points
     down and to the right — the (0.5, 0.866) direction below. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="27"
                android:startY="7.2"
                android:endX="81"
                android:endY="100.8">
                <item android:offset="0" android:color="#C8FF4D" />
                <item android:offset="1" android:color="#A3D62F" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
