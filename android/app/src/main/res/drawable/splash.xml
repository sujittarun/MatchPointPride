<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen, on Android 11 and below.

     On API 31+ the system draws the splash itself from
     windowSplashScreenBackground and windowSplashScreenAnimatedIcon
     (see values/styles.xml) and this is not used. Both routes end up
     the same: the app's own ––plane behind the mark, so the moment the
     WebView takes over there is nothing to see change.

     The template shipped ten splash PNGs — portrait and landscape at
     five densities — of the Capacitor logo. They are gone; a vector on
     a colour needs no densities and no landscape variant. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/plane" />
    <item
        android:gravity="center"
        android:width="132dp"
        android:height="132dp"
        android:drawable="@drawable/logo_mark" />
</layer-list>
