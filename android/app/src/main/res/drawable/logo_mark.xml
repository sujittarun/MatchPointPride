<?xml version="1.0" encoding="utf-8"?>
<!-- The complete mark — lime tile, ink shuttlecock — as one drawable.

     The adaptive icon splits these into two layers because a launcher
     needs to mask and parallax them separately. Everywhere else that
     wants the logo (the splash, and the system splash icon on API 31+)
     wants it whole, and the corner radius back: 32.4/108 is the same
     30% BrandMark rounds its tile by.

     A vector, not a PNG, so the splash is one file instead of ten and
     is exact at every density. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M32.4,0 H75.6 A32.4,32.4 0 0 1 108,32.4 V75.6 A32.4,32.4 0 0 1 75.6,108 H32.4 A32.4,32.4 0 0 1 0,75.6 V32.4 A32.4,32.4 0 0 1 32.4,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="27"
                android:startY="7.2"
                android:endX="81"
                android:endY="100.8">
                <item android:offset="0" android:color="#C8FF4D" />
                <item android:offset="1" android:color="#A3D62F" />
            </gradient>
        </aapt:attr>
    </path>
    <group
        android:scaleX="2.61"
        android:scaleY="2.61"
        android:translateX="22.68"
        android:translateY="22.68">
        <path
            android:fillColor="#0B1004"
            android:pathData="M9.5,12.9 L6.9,4.9 A1.1,1.1 0 0 1 7.95,3.4 H16.05 A1.1,1.1 0 0 1 17.1,4.9 L14.5,12.9 Z" />
        <path
            android:fillColor="#0B1004"
            android:pathData="M8.5,17.6 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
    </group>
</vector>
