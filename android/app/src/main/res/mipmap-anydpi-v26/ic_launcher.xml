<?xml version="1.0" encoding="utf-8"?>
<!-- Every device from Android 8 onward reads this and ignores the PNGs.

     The monochrome layer is what Android 13's themed icons tint to the
     wallpaper's colour — without it, this is the one bright tile on a
     themed home screen. The system supplies the colour, so reusing the
     ink foreground is right: only its shape is read. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
